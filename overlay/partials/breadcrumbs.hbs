{{!--
  Two changes from the stock partial:
  1. The leading component-title crumb is dropped. For the ROOT component this
     was rendering a redundant "kieranpotts.com" crumb; for the other
     components it was already suppressed by the stock dedup guard, so removing
     the block entirely is safe and leaves their breadcrumbs as-is.
  2. On the home page the breadcrumb trail (just "Home") is suppressed entirely
     — the home-link icon already represents it — and the wrapping <nav> is
     omitted too, so no empty element is emitted.
--}}
{{#unless page.home}}
{{#if page.breadcrumbs}}
<nav class="breadcrumbs" aria-label="breadcrumbs">
  <ul>
    {{#each page.breadcrumbs}}
    <li>
    {{~#if (and ./url (eq ./urlType 'internal'))~}}
    <a href="{{{relativize ./url}}}">{{{./content}}}</a>
    {{~else~}}
    {{{./content}}}
    {{~/if~}}
    </li>
    {{/each}}
  </ul>
</nav>
{{/if}}
{{/unless}}
