// Config for audit-ci (https://github.com/IBM/audit-ci), used by the
// "Audit dependencies" CI step in place of a plain `npm audit`.
//
// Blocks the build on high/critical-severity findings. If an unfixable
// advisory needs to be tolerated, add an "allowlist" here with a comment
// explaining the accepted risk, and remove the entry once it's fixed
// upstream (re-run `npm audit` locally to confirm).
{
  "$schema": "https://raw.githubusercontent.com/IBM/audit-ci/main/docs/schema.json",
  "high": true
}
