#!/usr/bin/env bash

#
# Watches src/ and site-dev.yml for changes and rebuilds the site
# automatically. Does not serve the output; use ./run/serve for that.
#
# Stop watching with Ctrl+C.
#

# Exit immediately on error (-e), treat unset variables as errors (-u), and
# propagate failures through pipelines (-o pipefail).

set -euo pipefail

# Resolve the project root (parent of the run/ directory) and change into it.
# This ensures npm always finds package.json, and mise finds mise.toml,
# regardless of where this script is invoked from.

cd "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/.."

# chokidar-cli runs the rebuild command through the shell named by $SHELL, and
# crashes on the first file change if it is unset, as it can be in a container
# or under a coding agent. Default it to sh.

export SHELL="${SHELL:-/bin/sh}"

# Run npm under the Node.js version pinned in .nvmrc, via mise (see mise.toml).
# This is the same on the host and in the devcontainer, whether or not mise is
# activated in the calling shell. Run ./run/install first.
#
# Ctrl+C (SIGINT) exits with code 130; the || clause suppresses that spurious
# error. Any other non-zero exit code still fails the script.

mise exec -- npm run watch \
  || [ "$?" -eq 130 ]
