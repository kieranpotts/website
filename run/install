#!/usr/bin/env bash

#
# Installs the pinned Node.js version and the project's dependencies. Run this
# once on a new machine or devcontainer, and again whenever .nvmrc or
# package.json changes.
#

# Exit immediately on error (-e), treat unset variables as errors (-u), and
# propagate failures through pipelines (-o pipefail).

set -euo pipefail

# Resolve the project root (parent of the run/ directory) and change into it.
# This ensures npm always finds package.json, and mise finds mise.toml,
# regardless of where this script is invoked from.

cd "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/.."

if ! command -v mise >/dev/null 2>&1; then
  echo "mise is required to install this project's toolchain." >&2
  echo "Install it from https://mise.jdx.dev, then re-run this script." >&2
  exit 1
fi

# mise refuses to read a project's `mise.toml` until it has been trusted.
# Running this script is already a decision to trust this repository, so trust
# its `mise.toml` here, rather than as a separate manual step. This is
# idempotent.

mise trust
mise install

# Run npm under the Node.js version pinned in .nvmrc, via mise (see mise.toml).
# This is the same on the host and in the devcontainer, whether or not mise is
# activated in the calling shell.

mise exec -- npm install
