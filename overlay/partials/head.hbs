{{! Document <head> contents for kieranpotts.com.
This overrides the theme's default `partials/head.hbs`, shipped via
`supplemental_files` (the overlay) in the site playbooks — a supplemental
partial of the same path replaces the one baked into the UI bundle - keeping
the theme generic. This adds the site's feed `<link>` tags. }}

<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{#if page.title}}{{{page.title}}} :: {{/if}}{{site.title}}</title>
{{#if page.description}}
  <meta name="description" content="{{page.description}}">
{{/if}}
{{#if page.keywords}}
  <meta name="keywords" content="{{page.keywords}}">
{{/if}}
{{#if (and site.url page.canonicalUrl)}}
  <link rel="canonical" href="{{page.canonicalUrl}}">
{{/if}}
<link rel="stylesheet" href="{{{uiRootPath}}}/css/site.css">
<script src="{{{uiRootPath}}}/js/site.js" defer></script>
<link rel="alternate" type="application/rss+xml" title="{{site.title}}" href="{{{siteRootPath}}}/feeds/rss.xml">
<link rel="alternate" type="application/atom+xml" title="{{site.title}}" href="{{{siteRootPath}}}/feeds/atom.xml">
<link rel="alternate" type="application/feed+json" title="{{site.title}}" href="{{{siteRootPath}}}/feeds/feed.json">
{{#if page.home}}
  <meta name="robots" content="index, follow">
{{/if}}
