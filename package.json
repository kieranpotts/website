{
  "private": true,
  "name": "kieranpotts-website",
  "description": "kieranpotts.com",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build": "antora --stacktrace --fetch --cache-dir cache --redirect-facility static --clean site-local.yml",
    "clean": "rm -rf public cache",
    "serve": "http-server public/ -p 8080 -c-1",
    "watch": "chokidar 'src/**/*' 'overlay/**/*' 'site-local.yml' -c 'npm run build'",
    "preview": "concurrently -k -n watch,serve 'npm run watch' 'npm run serve'",
    "lint": "antora --stacktrace --fetch --cache-dir cache --log-failure-level=warn site-local.yml",
    "lint:ci": "antora --stacktrace --fetch --cache-dir cache --log-failure-level=warn site-ci.yml",
    "linkcheck": "linkinator public/ --recurse --skip 'https?://(?!localhost)'"
  },
  "dependencies": {
    "antora": "^3.1.10"
  },
  "devDependencies": {
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.0.0",
    "http-server": "^14.1.1",
    "linkinator": "^7.6.1"
  }
}
