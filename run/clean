#!/usr/bin/env bash

#
# Removes build output and caches: public/, cache/, src/ui/dist/, www/, tmp/.
#

# Exit immediately on error (-e), treat unset variables as errors (-u), and
# propagate failures through pipelines (-o pipefail).

set -euo pipefail

# Resolve the project root (parent of the run/ directory) and change into it.
# This ensures npm always finds package.json, and mise finds mise.toml,
# regardless of where this script is invoked from.

cd "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/.."

# Run npm under the Node.js version pinned in .nvmrc, via mise (see mise.toml).
# This is the same on the host and in the devcontainer, whether or not mise is
# activated in the calling shell. Run ./run/install first.

exec mise exec -- npm run clean
